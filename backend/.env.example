# PostgreSQL 연결 문자열(필수)
DB_CONN_STRING=postgresql://USER:PASSWORD@HOST:5432/cal-todo
# 선택: 주기 작업 간격(ms). 없으면 기본값
# JOB_RESERVATION_INTERVAL_MS=60000
# JOB_DAILY_INTERVAL_MS=86400000
# 실행 환경(선택). 기본 development / 3000
# NODE_ENV=development
# PORT=3000
# JWT 서명 키(필수, 서로 다른 32바이트 이상 난수). 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 테스트: 같은 키를 .env.test에 두고 DB만 cal-todo-test로 바꾼다
# 프론트엔드 출처(production 필수). refresh·logout의 Origin 검사에 쓴다
# FRONTEND_ORIGIN=http://localhost:5173
# Access Token 수명(초, 선택). 기본 900
# JWT_ACCESS_TTL_SEC=900
# 앞단 프록시 홉 수(선택). 기본 0, Cloudflare 뒤 배포 시 1
# TRUST_PROXY=0
# Role별 모델(production 필수) provider:modelId, provider = google | anthropic | mock. 기본 mock:ok
# 착수 시 현행 모델 ID로 교체(PRD-R-9)
# LLM_MAIN=google:gemini-2.5-flash
# LLM_MAIN=anthropic:claude-sonnet-4-5
# LLM_LIGHT=google:gemini-2.5-flash-lite
# provider API 키(해당 provider를 쓸 때 필수, AI SDK가 직접 읽는다)
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# 이미지 스토리지(DEC-07). S3_ENDPOINT가 있으면 R2(S3 호환)를 쓰고 아래 4개가 필수, production은 S3_ENDPOINT 필수
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PRIVATE_BUCKET=cal-todo-private
# S3_PUBLIC_BUCKET=cal-todo-public
# S3_ENDPOINT가 없을 때 로컬 저장 디렉터리(선택). 기본 .storage, 테스트는 .storage-test
# STORAGE_LOCAL_DIR=.storage
# 공개 버킷의 공개 도메인(production 필수, 끝 / 없이). 최종 HTML 이미지 URL의 앞부분
# PUBLIC_IMAGE_BASE_URL=http://localhost:3000/public-images
